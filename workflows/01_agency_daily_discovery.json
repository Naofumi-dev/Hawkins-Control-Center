      },
      "credentials": {
        "telegramApi": {
          "name": "CLIENT_FINDER_TELEGRAM_BOT"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "cf-discovery-card-alert",
      "name": "Tell Owner Review Card Incomplete",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1340,
        360
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Owner Configuration').first().json.chat_id }}",
        "text": "Client Finder stopped an incomplete review card. No approval button was posted for that draft; check its stored evidence and message.",
        "additionalFields": {
          "appendAttribution": false,
          "disable_web_page_preview": true,
          "parse_mode": "HTML"
        }
      },
      "credentials": {
        "telegramApi": {
          "name": "CLIENT_FINDER_TELEGRAM_BOT"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "cf-discovery-delivery-alert",
      "name": "Tell Owner Review Card Delivery Failed",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1560,
        380
      ],
      "notesInFlow": true,
      "notes": "This alert may also fail if Telegram is unavailable. An independent n8n error workflow or external alert channel is required before activation.",
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Owner Configuration').first().json.chat_id }}",
        "text": "Client Finder could not confirm delivery of a review card. Check the dedicated bot conversation and stored draft before running discovery again.",
        "additionalFields": {
          "appendAttribution": false,
          "disable_web_page_preview": true,
          "parse_mode": "HTML"
        }
      },
      "credentials": {
        "telegramApi": {
          "name": "CLIENT_FINDER_TELEGRAM_BOT"
        }
      },
