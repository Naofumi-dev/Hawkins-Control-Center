    },
    {
      "id": "cf-discovery-id-alert",
      "name": "Tell Owner Telegram Card ID Uncertain",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1780,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Owner Configuration').first().json.chat_id }}",
        "text": "A Client Finder review card may have appeared, but its Telegram ID was not confirmed. Its approval buttons cannot send; inspect the bot chat and database before retrying.",
        "additionalFields": {
          "appendAttribution": false,
          "disable_web_page_preview": true,
          "parse_mode": "HTML"
        }
      },
      "credentials": {
        "telegramApi": {
          "name": "CLIENT_FINDER_TELEGRAM_BOT"
        }
      },
      "onError": "continueErrorOutput"
    }
  ],
